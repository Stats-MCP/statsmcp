{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "statsmcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": false },
  "routes": [{ "pattern": "statsmcp.dev", "custom_domain": true }],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
