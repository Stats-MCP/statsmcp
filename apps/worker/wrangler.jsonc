{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "statsmcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": false },
  "routes": [
    { "pattern": "statsmcp.dev/si/mcp*", "zone_name": "statsmcp.dev" },
    { "pattern": "statsmcp.dev/no/mcp*", "zone_name": "statsmcp.dev" },
    { "pattern": "statsmcp.dev/ee/mcp*", "zone_name": "statsmcp.dev" },
    { "pattern": "statsmcp.dev/fo/mcp*", "zone_name": "statsmcp.dev" },
    { "pattern": "statsmcp.dev/fi/mcp*", "zone_name": "statsmcp.dev" },
    { "pattern": "statsmcp.dev/se/mcp*", "zone_name": "statsmcp.dev" },
    { "pattern": "statsmcp.dev/dk/mcp*", "zone_name": "statsmcp.dev" },
    { "pattern": "statsmcp.dev/nl/mcp*", "zone_name": "statsmcp.dev" },
    { "pattern": "statsmcp.dev/eu/mcp*", "zone_name": "statsmcp.dev" },
    { "pattern": "statsmcp.dev/ca/mcp*", "zone_name": "statsmcp.dev" },
    { "pattern": "statsmcp.dev/is/mcp*", "zone_name": "statsmcp.dev" },
    { "pattern": "statsmcp.dev/hr/mcp*", "zone_name": "statsmcp.dev" },
    { "pattern": "statsmcp.dev/ie/mcp*", "zone_name": "statsmcp.dev" },
    { "pattern": "statsmcp.dev/index/*", "zone_name": "statsmcp.dev" }
  ],
  "r2_buckets": [{ "binding": "INDEX", "bucket_name": "statsmcp-index" }],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
