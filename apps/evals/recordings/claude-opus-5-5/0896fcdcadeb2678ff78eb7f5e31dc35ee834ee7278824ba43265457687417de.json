              "type": "string",
              "minLength": 2,
              "description": "Keywords to search for."
            },
            "lang": {
              "description": "Language of titles. Default \"no\".",
              "type": "string",
              "enum": [
                "no",
                "en"
              ]
            },
            "limit": {
              "description": "Maximum results. Default 10.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "includeArchived": {
