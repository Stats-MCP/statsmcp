{
  "name": "sistat-mcp",
  "version": "0.1.0",
  "description": "MCP server for SiStat, the database of the Statistical Office of the Republic of Slovenia (SURS)",
  "license": "MIT",
  "author": "Tadej Polajnar",
  "homepage": "https://github.com/TadejPolajnar/pxweb-mcp/tree/main/packages/sistat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TadejPolajnar/pxweb-mcp.git",
    "directory": "packages/sistat"
  },
  "bugs": {
    "url": "https://github.com/TadejPolajnar/pxweb-mcp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "sistat",
    "surs",
    "slovenia",
    "statistics",
    "pxweb"
  ],
  "bin": {
    "sistat-mcp": "./dist/bin.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "catalog:",
    "pxweb-mcp": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
