{
  "name": "@statsmcp/core",
  "version": "0.3.0",
  "description": "MCP server toolkit for PxWeb API v1 statistics databases",
  "license": "MIT",
  "author": "Tadej Polajnar",
  "homepage": "https://statsmcp.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stats-MCP/statsmcp.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Stats-MCP/statsmcp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "pxweb",
    "statistics",
    "open-data"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:update": "UPDATE_FLOORS=1 vitest run eval/search-quality.test.ts",
    "eval:fixtures": "node eval/build-fixtures.mjs"
  },
  "dependencies": {
    "minisearch": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
