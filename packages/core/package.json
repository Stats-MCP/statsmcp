{
  "name": "pxweb-mcp",
  "version": "0.1.0",
  "description": "MCP server toolkit for PxWeb API v1 statistics databases",
  "license": "MIT",
  "author": "Tadej Polajnar",
  "homepage": "https://github.com/TadejPolajnar/statsmcp/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TadejPolajnar/statsmcp.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/TadejPolajnar/statsmcp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "pxweb",
    "statistics",
    "open-data"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
