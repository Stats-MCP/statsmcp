{
  "name": "statice-mcp",
  "version": "0.3.0",
  "description": "MCP server for the PX-Web database of Statistics Iceland (Hagstofa Íslands)",
  "license": "MIT",
  "author": "Tadej Polajnar",
  "homepage": "https://statsmcp.dev/iceland/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stats-MCP/statsmcp.git",
    "directory": "packages/statice"
  },
  "bugs": {
    "url": "https://github.com/Stats-MCP/statsmcp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "statice",
    "hagstofa",
    "iceland",
    "statistics",
    "pxweb"
  ],
  "bin": {
    "statice-mcp": "./dist/bin.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "snapshots"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "catalog:",
    "pxweb-mcp": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
