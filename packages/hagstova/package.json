{
  "name": "hagstova-mcp",
  "version": "0.2.0",
  "description": "MCP server for the StatBank of Statistics Faroe Islands (Hagstova Føroya)",
  "license": "MIT",
  "author": "Tadej Polajnar",
  "homepage": "https://statsmcp.dev/faroe-islands/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stats-MCP/statsmcp.git",
    "directory": "packages/hagstova"
  },
  "bugs": {
    "url": "https://github.com/Stats-MCP/statsmcp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "hagstova",
    "faroe-islands",
    "statbank",
    "statistics",
    "pxweb"
  ],
  "bin": {
    "hagstova-mcp": "./dist/bin.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "catalog:",
    "pxweb-mcp": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
