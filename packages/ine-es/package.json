{
  "name": "@statsmcp/ine-es",
  "version": "0.5.0",
  "description": "MCP server for the Tempus3 database of the National Statistics Institute of Spain (INE)",
  "license": "MIT",
  "author": "Tadej Polajnar",
  "homepage": "https://statsmcp.dev/spain/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stats-MCP/statsmcp.git",
    "directory": "packages/ine-es"
  },
  "bugs": {
    "url": "https://github.com/Stats-MCP/statsmcp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "ine",
    "tempus",
    "spain",
    "españa",
    "statistics"
  ],
  "bin": {
    "ine-es-mcp": "./dist/bin.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "snapshots"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "catalog:",
    "@statsmcp/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
