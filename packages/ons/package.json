{
  "name": "@statsmcp/ons",
  "version": "0.6.0",
  "description": "MCP server for the time series of the Office for National Statistics (United Kingdom)",
  "license": "MIT",
  "author": "Tadej Polajnar",
  "homepage": "https://statsmcp.dev/united-kingdom/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stats-MCP/statsmcp.git",
    "directory": "packages/ons"
  },
  "bugs": {
    "url": "https://github.com/Stats-MCP/statsmcp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "ons",
    "office-for-national-statistics",
    "united-kingdom",
    "statistics"
  ],
  "bin": {
    "ons-mcp": "./dist/bin.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "catalog:",
    "@statsmcp/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
